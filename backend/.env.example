# Google Cloud
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=.secrets/service-account.json

# Gemini LLM
GEMINI_MODEL_NAME=gemini-2.0-flash

# Embedding
EMBEDDING_MODEL_NAME=text-embedding-004

# Firestore
FIRESTORE_COLLECTION_KNOWLEDGE=knowledge

# Auth
# Set AUTH_REQUIRED=false for local dev to skip Firebase JWT verification
AUTH_REQUIRED=true
# Comma-separated allowed CORS origins for production
# Example: CORS_ORIGINS=https://your-app.vercel.app,https://localhost:3000
CORS_ORIGINS=

# Server
HOST=0.0.0.0
PORT=8000
# DEBUG should be false in production. Only set true for local debugging.
DEBUG=false

# Screener — shared-secret token for Cloud Scheduler /api/screener/run
# Leave empty to disable the runner endpoint.
SCREENER_RUNNER_TOKEN=

# Screener email (optional). Without SENDGRID_API_KEY notify endpoint runs in dry-run mode.
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=notify@navi-stock.app
EMAIL_FROM_NAME=Navi 智能選股
# HMAC secret for one-click unsubscribe links
SCREENER_UNSUBSCRIBE_SECRET=
# Public base URL used in email CTA + unsubscribe (e.g. https://navi-stock-analyzer.web.app)
SCREENER_PUBLIC_BASE_URL=https://navi-stock-analyzer.web.app
